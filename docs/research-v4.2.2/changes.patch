+#!/usr/bin/env python3
+"""Package a verified current release, preserving executable permission bits."""
+import argparse
+from pathlib import Path
+import sys
+import zipfile
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from core.package_verifier import verify_tree, verify_zip
+from core.version import VERSION
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    result = verify_tree(ROOT, compile_python=False)
+    if not result['passed']: raise SystemExit(str(result['issues'][:10]))
+    output = args.output.resolve()
+    if output.is_relative_to(ROOT): raise SystemExit('write the archive outside its source tree')
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with zipfile.ZipFile(output, 'w', zipfile.ZIP_DEFLATED, compresslevel=6) as archive:
+        for path in sorted(ROOT.rglob('*')):
+            rel = path.relative_to(ROOT)
+            if any(part in {'.git', '.venv', '__pycache__', '.pytest_cache'} for part in rel.parts): continue
+            if path.is_symlink(): raise ValueError('cannot package symlink: '+str(rel))
+            if path.is_file(): archive.write(path, 'TBHM-'+VERSION+'/'+rel.as_posix())
+    result = verify_zip(output)
+    if not result['passed']: raise SystemExit(str(result['issues'][:10]))
+    print(str(output)+'\nSHA256 '+result['sha256']+'\nVerified '+str(result['manifest_entries_checked'])+' manifest entries')
+    return 0
+
+
+if __name__ == '__main__': raise SystemExit(main())
