--- /dev/null
+++ b/scripts/check_done.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""The HIGH-LEVEL SCANNER finish line, intentionally distinct from release QA."""
+import json,sys
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT))
+from core.version import VERSION
+FLAGS=['external_scanner_traffic_globally_metered','global_wire_enforcement','offline_is_os_network_namespace',
+       'all_sensitive_writers_reviewed','all_vulnerability_classes_auto_confirmable']
+def main():
+ info=json.loads((ROOT/f'RELEASE_INFO-v{VERSION}.json').read_text());s=info['safety_model'];failures=[]
+ for flag in FLAGS:
+  if s.get(flag) is not True:failures.append(flag+' remains open')
+ v=json.loads((ROOT/'docs/research-v4.2.5/VERIFICATION.json').read_text())
+ for kind in s['strict_classes']:
+  item=v['strict_class_evidence'].get(kind,{})
+  for key in ('fixtures','vectors','matrix','behavioral_guard'):
+   value=item.get(key)
+   if not isinstance(value,str) or not (ROOT/value).is_file():failures.append(kind+': missing '+key)
+ held=v['representative_held_out']
+ if held.get('status')!='DEFERRED' and not held.get('record'):failures.append('representative held-out evidence missing')
+ standards=json.loads((ROOT/'docs/research-v4.2.5/STANDARDS_EXECUTION.json').read_text())
+ if standards.get('full_requirement_level_coverage') is not True:failures.append('full requirement-level standards execution remains open')
+ print(json.dumps({'high_level_scanner_done':not failures,'release_status':info['release_status'],'failures':failures},indent=2))
+ return int(bool(failures))
+if __name__=='__main__':raise SystemExit(main())
